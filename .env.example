# =====================================================================
# .env.example — Plug-and-Play MCP Architecture
# Copy to `.env` and fill in values before `docker compose up`.
# =====================================================================

# ---------- PostgreSQL (shared: app DB + cognee_db) ----------
POSTGRES_USER=workspace_user
POSTGRES_PASSWORD=workspace_pass
POSTGRES_DB=workspace_db
# Separate DB provisioned by scripts/postgres-init for Cognee
COGNEE_DB_NAME=cognee_db

# ---------- Neo4j (graph backend for Cognee) ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_pass
# Browser: http://localhost:7474  |  Bolt: bolt://localhost:7687

# ---------- OpenAI (LLM + Embeddings) ----------
# Required. Used by Cognee MCP for both completions and embeddings.
OPENAI_API_KEY=sk-REPLACE_ME

# LLM
LLM_MODEL=gpt-4o
LLM_ENDPOINT=https://api.openai.com/v1

# Fallback LLM — Cognee switches to this automatically when the primary hits rate limits.
# Set to any LiteLLM-compatible model string (groq/*, ollama/*, openai/*, azure/*, etc.)
# Leave blank to disable fallback.
FALLBACK_MODEL=groq/llama-3.3-70b-versatile
FALLBACK_API_KEY=gsk_REPLACE_ME
FALLBACK_ENDPOINT=https://api.groq.com/openai/v1

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_ENDPOINT=https://api.openai.com/v1
# Must match the model's native dimensionality:
#   text-embedding-3-small -> 1536
#   text-embedding-3-large -> 3072
EMBEDDING_DIMENSIONS=1536

# ---------- Cognee MCP ----------
MCP_LOG_LEVEL=INFO

# ---------- FastAPI App ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- MCP Wrapper (mcp_wrapper.py / Docker service mcp-wrapper) ----------
# Port the wrapper listens on
MCP_WRAPPER_PORT=8002

# Structured log level for the wrapper (DEBUG | INFO | WARNING | ERROR)
MCP_WRAPPER_LOG_LEVEL=INFO

# API key guard — leave empty to disable auth (Phase 5)
# Comma-separated to support multiple keys: key1,key2
MCP_WRAPPER_API_KEY=

# Reject tools/call requests that arrive without a valid mcp-session-id (Phase 1)
MCP_WRAPPER_STRICT_SESSIONS=false

# Session eviction TTL in seconds — sessions older than this are dropped (Phase 1)
MCP_WRAPPER_SESSION_TTL=3600

# Cognee MCP reconnection settings (Phase 3)
MCP_WRAPPER_RECONNECT_DELAY=5
MCP_WRAPPER_MAX_RECONNECT_ATTEMPTS=10

# Rate-limit retry — when Cognee's upstream LLM returns 429, the wrapper
# retries with exponential backoff before surfacing the error to the agent.
# Increase BASE_DELAY or MAX_ATTEMPTS if hitting sustained rate limits.
COGNEE_RETRY_MAX_ATTEMPTS=4
COGNEE_RETRY_BASE_DELAY=5.0
COGNEE_RETRY_MAX_DELAY=60.0

# Docker container name for docker-exec-based tools (memify, visualize_graph)
COGNEE_CONTAINER_NAME=cognee_mcp_server

# Shared volume path where graph HTML is written (used by web + mcp-wrapper services)
GRAPH_OUTPUT_PATH=/graph/cognee_graph.html

# Enable incremental SSE streaming for tool calls (Phase 6)
# false (default) — buffer full result, emit single event (compatible with all clients)
# true            — stream events as they arrive; subprocess tools send heartbeat pings
MCP_WRAPPER_STREAMING=false
