# Application Settings
APP_HOST=localhost
APP_PORT=8000
APP_ENV=development
WORKERS_COUNT=4
LOG_LEVEL=INFO

# API Settings
API_TITLE=Workspace Service API
API_DESCRIPTION=Manages workspaces with CRUD operations.
API_VERSION=1.0.0
API_PREFIX=/api
API_DOCS_URL=/api/docs
API_REDOC_URL=/api/redoc
API_OPENAPI_URL=/api/openapi.json

# CORS Settings (JSON format for list)
CORS_ORIGINS=["*"]

# Database Settings (Required)
DB_USER=workspace_user
DB_PASSWORD=workspace_pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workspace_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False
DB_ENABLE_MULTI_TENANT=False
DB_DEFAULT_TENANT_ID=default

# Cognee Memory Subsystem Settings
COGNEE_MCP_ENDPOINT=http://localhost:8000/mcp
COGNEE_TIMEOUT_SECONDS=10

# Cognee MCP Docker Configuration (set in docker-compose.yml, not .env)
# These are only needed if running Cognee MCP in Docker:
# - LLM_PROVIDER=ollama
# - LLM_MODEL=mistral
# - LLM_ENDPOINT=http://host.docker.internal:11434
# - LLM_API_KEY=ollama
# - EMBEDDING_PROVIDER=ollama
# - EMBEDDING_MODEL=nomic-embed-text
# - EMBEDDING_ENDPOINT=http://host.docker.internal:11434
# - EMBEDDING_DIMENSIONS=768
# - HUGGINGFACE_TOKENIZER=nomic-ai/nomic-embed-text-v1
# - DB_PROVIDER=sqlite
# - VECTOR_DB_PROVIDER=lancedb
# - GRAPH_DATABASE_PROVIDER=kuzu
