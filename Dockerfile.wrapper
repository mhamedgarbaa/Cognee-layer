FROM python:3.11-slim

WORKDIR /app

COPY requirements-wrapper.txt .
RUN pip install --no-cache-dir -r requirements-wrapper.txt

# Copy only what the wrapper needs
COPY mcp_wrapper.py .
COPY graph_builder.py .
COPY configuration/ ./configuration/

EXPOSE 8002

CMD ["uvicorn", "mcp_wrapper:app", "--host", "0.0.0.0", "--port", "8002"]
