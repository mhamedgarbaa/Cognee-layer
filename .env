# Application Settings
APP_HOST=localhost
APP_PORT=8000
APP_ENV=development
WORKERS_COUNT=4
LOG_LEVEL=INFO

# API Settings
API_TITLE=Cognee Memory System
API_DESCRIPTION=Manages temporal memory with Cognee MCP
API_VERSION=1.0.0
API_PREFIX=/api
API_DOCS_URL=/api/docs
API_REDOC_URL=/api/redoc
API_OPENAPI_URL=/api/openapi.json

# CORS Settings (JSON format for list)
CORS_ORIGINS=["*"]


# Database Settings
DB_USER=workspace_user
DB_PASSWORD=workspace_pass
DB_HOST=db
DB_PORT=5432
DB_NAME=workspace_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False
DB_ENABLE_MULTI_TENANT=False
DB_DEFAULT_TENANT_ID=default

# Cognee MCP Configuration
# Use service name within Docker network
MCP_SERVER_URL=http://localhost:8001
MCP_PROTOCOL=http
MCP_HOST_HEADER=localhost:8001
MCP_CONTAINER_NAME=cognee-mcp
MCP_TIMEOUT=300

# Resilience Settings
RETRY_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=60
CACHE_TTL=3600

# LLM (Ollama local)
LLM_PROVIDER="ollama"
LLM_MODEL="qwen2.5:latest"
LLM_API_KEY="ollama"
LLM_ENDPOINT="http://localhost:11434/v1"
LLM_FORMAT=json  # Force Ollama à répondre en JSON si Cognee le supporte
# Embeddings (Ollama local)
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text:latest"
EMBEDDING_DIMENSIONS="768"
EMBEDDING_API_KEY="ollama"
EMBEDDING_ENDPOINT="http://localhost:11434/api/embed"

# Recommended tokenizer for nomic embeddings
HUGGINGFACE_TOKENIZER="nomic-ai/nomic-embed-text-v1.5"
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Logging and Monitoring
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cognee-agent-api
COGNEE_SKIP_CONNECTION_TEST="true"
