@prefix bpi: <http://example.org/bpifrance#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bpi: a owl:Ontology ;
  rdfs:label "Bpifrance Document Ontology" .

bpi:CorporateDocument a owl:Class .
bpi:PolicyDocument a owl:Class ; rdfs:subClassOf bpi:CorporateDocument .
bpi:AnnualReport a owl:Class ; rdfs:subClassOf bpi:Report .
bpi:Report a owl:Class ; rdfs:subClassOf bpi:CorporateDocument .
bpi:FinancialStatement a owl:Class ; rdfs:subClassOf bpi:Report .
bpi:FrameworkDocument a owl:Class ; rdfs:subClassOf bpi:CorporateDocument .
bpi:AmendmentDocument a owl:Class ; rdfs:subClassOf bpi:CorporateDocument .
bpi:PressRelease a owl:Class ; rdfs:subClassOf bpi:CorporateDocument .

bpi:Organization a owl:Class .
bpi:Topic a owl:Class .

bpi:hasTitle a owl:DatatypeProperty ; rdfs:domain bpi:CorporateDocument ; rdfs:range xsd:string .
bpi:sourcePdf a owl:DatatypeProperty ; rdfs:domain bpi:CorporateDocument ; rdfs:range xsd:string .
bpi:rawTextFile a owl:DatatypeProperty ; rdfs:domain bpi:CorporateDocument ; rdfs:range xsd:string .
bpi:numPages a owl:DatatypeProperty ; rdfs:domain bpi:CorporateDocument ; rdfs:range xsd:integer .
bpi:numCharacters a owl:DatatypeProperty ; rdfs:domain bpi:CorporateDocument ; rdfs:range xsd:integer .
bpi:publicationYear a owl:DatatypeProperty ; rdfs:domain bpi:CorporateDocument ; rdfs:range xsd:gYear .
bpi:publishedBy a owl:ObjectProperty ; rdfs:domain bpi:CorporateDocument ; rdfs:range bpi:Organization .

bpi:Bpifrance a bpi:Organization ;
  rdfs:label "Bpifrance" .

